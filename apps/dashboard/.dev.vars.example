# Local-only values. Copy this file to .dev.vars; never commit the copy.
# Provider credentials will be added only when individual OAuth integrations ship.
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
OWNLANE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Generate a random value; this is used only to hash anonymous analytics visitors.
ANALYTICS_VISITOR_SALT=replace-with-a-long-random-value
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret
# Leave empty in development so "View site" points at this dev server.
PUBLIC_SITE_ORIGIN=

# Only secrets belong in this file. The public halves — VITE_TURNSTILE_SITE_KEY,
# VITE_VAPID_PUBLIC_KEY and VAPID_SUBJECT — are declared in wrangler.jsonc vars,
# which apply in development too. Set one here only to override it locally.

# Cloudflare Turnstile, protecting the public contact form. Leave unset locally:
# verification passes when the secret is absent so the form works in development.
TURNSTILE_SECRET_KEY=

# Web Push. Generate the pair with:
#   node apps/dashboard/scripts/generate-vapid-keys.mjs
# Push is never sent while this is unset.
VAPID_PRIVATE_KEY=
